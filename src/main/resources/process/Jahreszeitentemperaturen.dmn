  <decision id="Decision_0ksppu8" name="Jahreszeitentemperaturen">
    <decisionTable id="DecisionTable_0iipj3a">
      <input id="Input_1" label="Jahreszeit">
        <inputExpression id="InputExpression_1" typeRef="string">
          <text>jahreszeit</text>
        </inputExpression>
        <inputValues id="UnaryTests_17vr9ky">
          <text>"Winter","Frühling","Sommer","Herbst"</text>
        </inputValues>
      </input>
      <output id="Output_1" label="gefühlte Temperatur" name="gefuehlteTemperatur" typeRef="string">
        <outputValues id="UnaryTests_0888jgp">
          <text>"viel zu kalt","viel zu warm"</text>
        </outputValues>
      </output>
      <rule id="DecisionRule_0cx4bex">
        <inputEntry id="UnaryTests_0dahlpv">
          <text>"Winter","Frühling","Herbst"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0y7l295">
          <text>"viel zu kalt"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1y8ad4e">
        <inputEntry id="UnaryTests_0av3pnt">
          <text>"Sommer"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0d03h9v">
          <text>"viel zu warm"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_0ykxf0w">
        <inputEntry id="UnaryTests_1c9omxs">
          <text>"Fasnet", "Karneval", "Fasching"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0aaqpwt">
          <text>"ganz viel zu kalt"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
